  if(!data||!Array.isArray(data.cows)||!Array.isArray(data.milk)||!Array.isArray(data.money)||!Array.isArray(data.health)){
   throw new Error('Invalid');
  }
  const incCust=Array.isArray(data.customers)?data.customers:[];
  const incSales=Array.isArray(data.sales)?data.sales:[];
  const incFeed=Array.isArray(data.feed)?data.feed:[];
  const mode=$('#restoreMode').value;
  const summary=lang==='hi'
   ? `बैकअप विवरण:\n• गायें: ${data.cows.length}\n• दूध: ${data.milk.length}\n• आमदनी/खर्च: ${data.money.length}\n• स्वास्थ्य: ${data.health.length}\n• ग्राहक: ${incCust.length} | बिक्री: ${incSales.length}\n• चारा स्टॉक: ${incFeed.length}\n\n${mode==='merge'?'क्या पुराने डेटा में इसे जोड़ें?':'क्या मौजूदा पूरा डेटा बदलें?'}`
   : `Backup summary:\n• Cows: ${data.cows.length}\n• Milk: ${data.milk.length}\n• Money: ${data.money.length}\n• Health: ${data.health.length}\n• Customers: ${incCust.length} | Sales: ${incSales.length}\n• Feed items: ${incFeed.length}\n\n${mode==='merge'?'Merge with existing records?':'Replace all current records?'}`;
  if(!confirm(summary))return;

  if(mode==='merge'){
   save('cows',mergeUnique(read('cows'),data.cows));
   save('milk',mergeUnique(read('milk'),data.milk));
   save('money',mergeUnique(read('money'),data.money));
   save('health',mergeUnique(read('health'),data.health));
   save('customers',mergeUnique(read('customers'),incCust));
   save('sales',mergeUnique(read('sales'),incSales));
   save('feed',mergeUnique(read('feed'),incFeed));
  }else{
   save('cows',data.cows);save('milk',data.milk);save('money',data.money);save('health',data.health);
   save('customers',incCust);save('sales',incSales);save('feed',incFeed);
  }
  if(Number.isFinite(Number(data.milkRate)))localStorage.setItem('dm_milk_rate',String(data.milkRate));
  resetMilkEdit();render();toast(t('restored'));
 }catch(err){
  alert(t('invalidBackup'));
 }
}

$('#importBtn').addEventListener('click',()=>$('#importFile').click());
$('#importFile').addEventListener('change',e=>{
 const file=e.target.files[0];
 if(!file)return;
 const reader=new FileReader();
 reader.onload=()=>applyBackupText(String(reader.result||''));
 reader.onerror=()=>alert(t('invalidBackup'));
 reader.readAsText(file);
 e.target.value='';
});
$('#togglePasteBtn').addEventListener('click',()=>$('#pasteWrap').classList.toggle('hidden'));
$('#restorePasteBtn').addEventListener('click',()=>{
 const txt=$('#pasteInput').value.trim();
 if(!txt)return;
 applyBackupText(txt);
 $('#pasteInput').value='';$('#pasteWrap').classList.add('hidden');
});

function setLang(){
 localStorage.setItem('dm_lang',lang);
 document.documentElement.lang=lang;
 document.querySelectorAll('[data-i]').forEach(el=>{
  const k=el.dataset.i;
  if(typeof words[lang][k]==='string')el.textContent=words[lang][k];
 });
 $('#langBtn').textContent=lang==='en'?'हिंदी':'English';
 $('#dateLine').textContent=new Date().toLocaleDateString(lang==='hi'?'hi-IN':'en-IN',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
 if(editingMilkIndex!==null){
  $('#milkSubmitBtn').textContent=t('updateMilk');
  $('#milkEditBanner').textContent=t('editingNote');
 }
 render();
}
$('#langBtn').addEventListener('click',()=>{lang=lang==='en'?'hi':'en';setLang()});

dateSet();
setLang();
</script>
</body>
</html>
