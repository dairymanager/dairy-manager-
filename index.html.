 try{
  await navigator.clipboard.writeText(txt);
  localStorage.setItem('dm_last_backup',data.exportedAt);
  render();toast(t('backupCopied'));
 }catch(err){
  $('#pasteWrap').classList.remove('hidden');
  $('#pasteInput').value=txt;$('#pasteInput').select();
  toast(t('backupCopied'));
 }
});

function mergeUnique(existing,incoming){
 const seen=new Set(existing.map(x=>JSON.stringify(x)));
 const out=[...existing];
 incoming.forEach(item=>{
  const sig=JSON.stringify(item);
  if(!seen.has(sig)){seen.add(sig);out.push(item);}
 });
 return out;
}

function applyBackupText(rawText){
