function buildBackupObject(){
 return {
  version:4,
  exportedAt:new Date().toISOString(),
  cows:read('cows'),
  milk:read('milk'),
  money:read('money'),
  health:read('health'),
  customers:read('customers'),
  sales:read('sales'),
  feed:read('feed'),
  milkRate:Number(localStorage.getItem('dm_milk_rate')||50)
 };
}

$('#exportBtn').addEventListener('click',()=>{
 const data=buildBackupObject();
 const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});
 const url=URL.createObjectURL(blob);
 const a=document.createElement('a');
 a.href=url;a.download=`dairy-manager-backup-${today}.json`;
 document.body.appendChild(a);a.click();a.remove();
 setTimeout(()=>URL.revokeObjectURL(url),1000);
 localStorage.setItem('dm_last_backup',data.exportedAt);
 render();toast(t('backupDownloaded'));
});

$('#copyBackupBtn').addEventListener('click',async()=>{
 const data=buildBackupObject();
