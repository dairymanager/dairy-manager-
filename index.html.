<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#176b4d">
<title>Dairy Manager V4</title>
<style>
:root{
 --green:#176b4d;--green-dark:#11523b;--green2:#e8f4ee;
 --bg:#f4f7f5;--ink:#18231e;--muted:#63706a;--line:#dfe6e2;--white:#fff;
 --red:#b94343;--red-bg:#fff1f1;
 --amber:#9a5b00;--amber-bg:#fff7e6;--amber-line:#f2d49b;
 --blue:#1d5fa7;--blue-bg:#eef5fc;
 --shadow:0 2px 10px rgba(24,35,30,.05);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:var(--bg);font-family:system-ui,-apple-system,Arial,Helvetica,sans-serif;color:var(--ink);line-height:1.4;padding-bottom:28px}
header{background:linear-gradient(135deg,var(--green),var(--green-dark));color:#fff;padding:18px 16px 22px;border-radius:0 0 22px 22px;box-shadow:0 4px 14px rgba(23,107,77,.18)}
.top{display:flex;justify-content:space-between;align-items:center;gap:10px}
.brand{font-weight:800;font-size:21px;display:flex;align-items:center;gap:6px}
.ver{font-size:11px;font-weight:700;background:#ffffff24;padding:2px 7px;border-radius:99px;vertical-align:middle}
.sub{font-size:12px;opacity:.88;margin-top:4px}
button,select,input,textarea{font:inherit}
button{cursor:pointer;border:0;border-radius:11px;padding:11px 14px;font-weight:700;min-height:44px;transition:transform .08s ease,opacity .15s ease}
button:active{transform:scale(.98)}
.lang{background:#ffffff22;color:#fff;border:1px solid #ffffff55;padding:8px 13px;min-height:38px;font-size:13px}
main{max-width:760px;margin:auto;padding:14px}
.welcome{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;margin:12px 0 10px;color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.stat,.panel{background:var(--white);border:1px solid var(--line);border-radius:16px;padding:14px;box-shadow:var(--shadow)}
.stat small{color:var(--muted);font-size:12px;display:block}
.stat strong{display:block;font-size:23px;margin-top:6px;line-height:1.15;word-break:break-word}
.stat span{font-size:11.5px;color:var(--muted);display:block;margin-top:4px}
.pnl-card{margin-top:10px;border-radius:16px;padding:14px 16px;display:flex;justify-content:space-between;align-items:center;gap:12px;border:1px solid var(--line);background:var(--white);box-shadow:var(--shadow)}
.pnl-card.profit{background:var(--green2);border-color:#c3e4d3;color:var(--green-dark)}
.pnl-card.loss{background:var(--red-bg);border-color:#f0c6c6;color:var(--red)}
.pnl-card .pnl-val{font-size:22px;font-weight:800;white-space:nowrap}
.nav-wrap{position:sticky;top:0;z-index:20;background:var(--bg);padding:12px 0 8px;margin:6px -14px 0;padding-left:14px;padding-right:14px}
.nav{display:flex;gap:7px;overflow-x:auto;scrollbar-width:none;-ms-overflow-style:none}
.nav::-webkit-scrollbar{display:none}
.nav button{white-space:nowrap;background:#e7ede9;color:#394a42;padding:9px 13px;min-height:40px;font-size:13.5px;border-radius:99px;flex-shrink:0}
.nav button.active{background:var(--green);color:#fff;box-shadow:0 2px 8px rgba(23,107,77,.25)}
.panel{margin-top:8px}
.panel h2{font-size:17px;margin:0 0 12px;display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap}
.actions{display:flex;gap:8px;flex-wrap:wrap}
.actions button{flex:1 1 auto}
.primary{background:var(--green);color:#fff}
.secondary{background:var(--green2);color:var(--green)}
.ghost{background:#eef2f0;color:#394a42}
.danger{background:var(--red-bg);color:var(--red)}
.edit-btn{background:var(--blue-bg);color:var(--blue)}
.sm-btn{padding:7px 11px;min-height:34px;font-size:12.5px;border-radius:8px}
.item{padding:12px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:flex-start;gap:10px;font-size:14px}
.item:first-of-type{border-top:0;padding-top:4px}
.item-main{min-width:0;flex:1}
.item-right{display:flex;flex-direction:column;align-items:flex-end;gap:6px;flex-shrink:0}
.item-btns{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
.muted{color:var(--muted);font-size:12px;margin-top:3px}
form{display:grid;gap:11px}
label{font-size:13px;font-weight:700;color:#394a42}
input,select,textarea{width:100%;padding:12px;border:1px solid #d3ddd7;border-radius:11px;background:#fff;color:var(--ink);min-height:44px}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--green);box-shadow:0 0 0 3px rgba(23,107,77,.12)}
.field{display:grid;gap:5px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.check-row{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:#394a42}
.check-row input[type=checkbox]{width:20px;height:20px;min-height:20px;margin:0;accent-color:var(--green)}
.empty{color:var(--muted);font-size:13px;padding:10px 0}
.hidden{display:none!important}
.banner{padding:11px 13px;border-radius:12px;font-size:13px;margin-bottom:12px;line-height:1.45}
.banner.warn{background:var(--amber-bg);border:1px solid var(--amber-line);color:var(--amber)}
.banner.info{background:var(--blue-bg);border:1px solid #c9dff6;color:var(--blue)}
.badge{display:inline-block;font-size:11px;font-weight:700;padding:2px 8px;border-radius:99px;vertical-align:middle;margin-left:5px}
.badge.dup{background:var(--amber-bg);color:var(--amber);border:1px solid var(--amber-line)}
.badge.due{background:var(--red-bg);color:var(--red)}
.badge.ok{background:var(--green2);color:var(--green)}
.seg{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;background:#edf2ef;padding:5px;border-radius:12px;margin-bottom:12px}
.seg button{background:transparent;color:#405149;padding:8px 4px;min-height:38px;font-size:12.5px;border-radius:9px}
.seg button.active{background:var(--white);color:var(--green);box-shadow:0 1px 4px rgba(0,0,0,.08)}
.sub-seg{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;background:#edf2ef;padding:5px;border-radius:12px;margin-bottom:14px}
.sub-seg button{background:transparent;color:#405149;padding:8px 4px;min-height:38px;font-size:12.5px;border-radius:9px}
.sub-seg button.active{background:var(--white);color:var(--green);box-shadow:0 1px 4px rgba(0,0,0,.08)}
.period-note{font-size:12px;color:var(--muted);margin:-4px 0 12px}
.restore-box{margin-top:12px;padding:12px;background:#f8faf9;border:1px solid var(--line);border-radius:12px}
.bill-box{background:#fff;border:1px solid #cfd8d3;border-radius:14px;padding:16px;margin-top:14px}
.bill-head{border-bottom:2px solid var(--green);padding-bottom:10px;margin-bottom:12px;display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
.bill-table{width:100%;border-collapse:collapse;font-size:13px;margin:10px 0}
.bill-table th,.bill-table td{border-bottom:1px solid var(--line);padding:7px 4px;text-align:left}
.bill-table th:last-child,.bill-table td:last-child{text-align:right}
.bill-totals{margin-top:10px;padding-top:8px;border-top:2px solid var(--line);display:grid;gap:4px;font-size:14px}
.bill-totals div{display:flex;justify-content:space-between}
.toast{position:fixed;left:50%;bottom:18px;transform:translateX(-50%) translateY(20px);background:#18231e;color:#fff;padding:11px 16px;border-radius:99px;font-size:13px;font-weight:600;box-shadow:0 6px 20px rgba(0,0,0,.22);opacity:0;pointer-events:none;transition:opacity .2s ease,transform .2s ease;z-index:50;max-width:92vw;text-align:center}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
footer{text-align:center;color:var(--muted);font-size:11.5px;padding:22px 10px 8px}
@media(min-width:600px){
 .grid{grid-template-columns:repeat(4,1fr)}
 header{padding-left:max(16px,calc((100% - 728px)/2));padding-right:max(16px,calc((100% - 728px)/2))}
}
@media print{
 body{background:#fff;padding:0}
 header,.welcome,.grid,.pnl-card,.nav-wrap,#home,#cows,#milk,#money,#health,#feed,#reports,footer,.toast,.no-print{display:none!important}
 #customers{display:block!important;border:0;box-shadow:none;padding:0;margin:0}
 #custSubAdd,#custSubSale,#custBillControls{display:none!important}
 #custSubBill{display:block!important}
 .bill-box{border:0;padding:0;margin:0}
}
</style>
</head>
<body>
<header>
 <div class="top">
  <div>
   <div class="brand">🐄 Dairy Manager <span class="ver">V4</span></div>
   <div class="sub" data-i="tagline">Smart Dairy Management</div>
  </div>
  <button class="lang" id="langBtn">हिंदी</button>
 </div>
 <div style="margin-top:18px;font-size:19px;font-weight:700" data-i="hello">Welcome to your dairy</div>
 <div class="sub" id="dateLine"></div>
</header>

<main>
 <div class="welcome" data-i="overview">Farm overview</div>
 <section class="grid">
  <div class="stat"><small data-i="totalCows">Total cows</small><strong id="cowCount">0</strong><span data-i="registered">Registered</span></div>
  <div class="stat"><small data-i="todayMilk">Today's milk</small><strong id="milkTotal">0 L</strong><span data-i="morningEvening">Morning + evening</span></div>
  <div class="stat"><small data-i="todayIncome">Today's income</small><strong id="incomeTotal">₹0</strong><span data-i="milkSales">Milk sales</span></div>
  <div class="stat"><small data-i="todayExpense">Today's expense</small><strong id="expenseTotal">₹0</strong><span data-i="farmCosts">Farm costs</span></div>
 </section>

 <div id="todayPnlCard" class="pnl-card">
  <div>
   <div style="font-size:12px;opacity:.85;font-weight:700" data-i="todayPnl">Today's Profit / Loss</div>
   <div id="todayPnlStatus" style="font-size:13px;margin-top:2px">—</div>
  </div>
  <div id="todayPnlVal" class="pnl-val">₹0</div>
 </div>

 <div class="nav-wrap">
  <nav class="nav" id="nav">
   <button class="active" data-tab="home" data-i="home">Home</button>
   <button data-tab="cows" data-i="cows">Cows</button>
   <button data-tab="milk" data-i="milk">Milk</button>
   <button data-tab="customers" data-i="customers">Customers & Bills</button>
   <button data-tab="feed" data-i="feed">Feed Stock</button>
   <button data-tab="money" data-i="money">Income & expenses</button>
   <button data-tab="health" data-i="health">Health</button>
   <button data-tab="reports" data-i="reports">Reports</button>
  </nav>
 </div>

 <!-- HOME -->
 <section id="home" class="panel">
  <div id="homeDupBanner" class="banner warn hidden"></div>
  <div id="homeFeedBanner" class="banner warn hidden"></div>
  <h2 data-i="quickActions">Quick actions</h2>
  <div class="actions">
   <button class="primary" data-go="milk" data-i="addMilk">+ Add milk record</button>
   <button class="secondary" data-go="customers" data-i="logCustomerSale">+ Customer sale</button>
   <button class="secondary" data-go="money" data-i="addExpense">+ Add expense</button>
   <button class="ghost" data-go="feed" data-i="manageFeed">Feed stock</button>
  </div>
  <h2 style="margin-top:20px" data-i="recent">Recent activity</h2>
  <div id="recentList" class="empty" data-i="noActivity">No records yet. Add your first record.</div>
 </section>

 <!-- COWS -->
 <section id="cows" class="panel hidden">
  <h2 data-i="cowManagement">Cow management</h2>
  <form id="cowForm">
   <div class="field"><label data-i="cowName">Cow name / ID</label><input name="name" required placeholder="e.g. Gauri / COW-01"></div>
   <div class="form-row">
    <div class="field"><label data-i="breed">Breed (optional)</label><input name="breed" placeholder="e.g. Sahiwal"></div>
    <div class="field"><label data-i="age">Age in years (optional)</label><input name="age" type="number" inputmode="decimal" min="0" step="0.1"></div>
   </div>
   <button class="primary" data-i="saveCow">Save cow</button>
  </form>
  <h2 style="margin-top:22px" data-i="cowList">Cow list</h2>
  <div id="cowList" class="empty">No cows added yet.</div>
 </section>

 <!-- MILK -->
 <section id="milk" class="panel hidden">
  <h2 data-i="milkRecords">Milk production record</h2>
  <div id="milkEditBanner" class="banner info hidden"></div>
  <form id="milkForm">
   <div class="form-row">
    <div class="field"><label data-i="date">Date</label><input name="date" id="milkDate" type="date" required></div>
    <div class="field"><label data-i="session">Session</label>
     <select name="session" id="milkSession">
      <option value="Morning" data-i="morning">Morning</option>
      <option value="Evening" data-i="evening">Evening</option>
     </select>
    </div>
   </div>
   <div class="form-row">
    <div class="field"><label data-i="cow">Cow</label><select name="cow" id="milkCow" required><option value="">Select cow</option></select></div>
    <div class="field"><label data-i="quantity">Milk quantity (litres)</label><input name="qty" id="milkQty" type="number" inputmode="decimal" min="0.1" step="0.1" required></div>
   </div>
   <div class="actions">
    <button type="submit" class="primary" id="milkSubmitBtn" data-i="saveMilk">Save milk record</button>
    <button type="button" class="ghost hidden" id="cancelMilkEditBtn" data-i="cancelEdit">Cancel edit</button>
   </div>
  </form>

  <h2 style="margin-top:22px">
   <span data-i="milkHistory">Milk history</span>
   <span id="milkCountBadge" class="muted" style="font-weight:600"></span>
  </h2>
  <div id="milkDupBanner" class="banner warn hidden"></div>
  <div id="milkList" class="empty">No milk records yet.</div>

  <div class="field" style="margin-top:18px;padding-top:14px;border-top:1px solid var(--line)">
   <label data-i="milkRate">Milk selling rate (₹ per litre)</label>
   <input id="milkRate" type="number" inputmode="decimal" min="0" step="0.5" value="50">
  </div>
  <div class="muted" data-i="rateHint">Used only to estimate milk value; it does not create an income entry.</div>
 </section>

 <!-- CUSTOMERS & MONTHLY BILLS -->
 <section id="customers" class="panel hidden">
  <h2 class="no-print" data-i="customerTitle">Customer sales & monthly bills</h2>
  <div class="sub-seg no-print" id="custSubSeg">
   <button class="active" data-sub="sale" data-i="subSale">Daily Sale</button>
   <button data-sub="add" data-i="subCustomers">Customers</button>
   <button data-sub="bill" data-i="subBill">Monthly Bill</button>
  </div>

  <!-- Sub-tab: Daily Customer Sale -->
  <div id="custSubSale">
   <form id="saleForm">
    <div class="form-row">
     <div class="field"><label data-i="customer">Customer</label><select name="customer" id="saleCust" required><option value="">Select customer</option></select></div>
     <div class="field"><label data-i="date">Date</label><input name="date" id="saleDate" type="date" required></div>
    </div>
    <div class="form-row">
     <div class="field"><label data-i="quantity">Milk quantity (litres)</label><input name="qty" id="saleQty" type="number" inputmode="decimal" min="0.1" step="0.1" required></div>
     <div class="field"><label data-i="ratePerL">Rate (₹ / L)</label><input name="rate" id="saleRate" type="number" inputmode="decimal" min="1" step="0.5" required></div>
    </div>
    <div class="form-row">
     <div class="field"><label data-i="session">Session</label>
      <select name="session">
       <option value="Morning" data-i="morning">Morning</option>
       <option value="Evening" data-i="evening">Evening</option>
      </select>
     </div>
     <div class="field"><label data-i="paidNow">Paid now (₹)</label><input name="paid" id="salePaid" type="number" inputmode="decimal" min="0" step="1" value="0"></div>
    </div>
    <label class="check-row"><input type="checkbox" id="syncIncomeChk" checked><span data-i="syncIncomeLabel">Add paid amount to Income automatically</span></label>
    <button class="primary" data-i="saveSale">Save customer sale</button>
   </form>

   <h2 style="margin-top:20px" data-i="recentSales">Recent customer sales</h2>
   <div id="saleList" class="empty">No customer sales yet.</div>
  </div>

  <!-- Sub-tab: Customer List & Add -->
  <div id="custSubAdd" class="hidden">
   <form id="custForm">
    <div class="field"><label data-i="customerName">Customer name</label><input name="name" required placeholder="e.g. Ramesh Sharma"></div>
    <div class="form-row">
     <div class="field"><label data-i="phone">Phone (optional)</label><input name="phone" type="tel" placeholder="e.g. 9876543210"></div>
     <div class="field"><label data-i="ratePerL">Rate (₹ / L)</label><input name="rate" id="custDefaultRate" type="number" inputmode="decimal" min="1" step="0.5" value="50" required></div>
    </div>
    <div class="field"><label data-i="dailyDefault">Default daily litres (optional)</label><input name="dailyQty" type="number" inputmode="decimal" min="0" step="0.5" placeholder="e.g. 2"></div>
    <button class="primary" data-i="saveCustomer">Save customer</button>
   </form>
   <h2 style="margin-top:20px" data-i="customerList">Customer list & dues</h2>
   <div id="custList" class="empty">No customers added yet.</div>
  </div>

  <!-- Sub-tab: Monthly Print/PDF Bill -->
  <div id="custSubBill" class="hidden">
   <div id="custBillControls">
    <div class="form-row">
     <div class="field"><label data-i="customer">Customer</label><select id="billCust"><option value="">Select customer</option></select></div>
     <div class="field"><label data-i="billMonth">Month</label><input id="billMonth" type="month"></div>
    </div>
    <div class="actions" style="margin-top:10px">
     <button class="primary" id="printBillBtn" data-i="printPdf">Print / Save PDF</button>
     <button class="secondary" id="copyBillBtn" data-i="copyBillText">Copy WhatsApp bill</button>
    </div>
   </div>
   <div id="billPreview" class="bill-box empty">Select a customer to preview monthly bill.</div>
  </div>
 </section>

 <!-- FEED STOCK INVENTORY -->
 <section id="feed" class="panel hidden">
  <h2 data-i="feedTitle">Feed & stock inventory</h2>
  <form id="feedForm">
   <div class="field"><label data-i="feedName">Feed item name</label><input name="name" required placeholder="e.g. Khal / Bhusa / Choker"></div>
   <div class="form-row">
    <div class="field"><label data-i="feedQty">Current stock</label><input name="qty" type="number" inputmode="decimal" min="0" step="0.5" required placeholder="e.g. 50"></div>
    <div class="field"><label data-i="feedUnit">Unit</label>
     <select name="unit">
      <option value="kg">kg</option>
      <option value="bags">bags</option>
      <option value="quintal">quintal</option>
     </select>
    </div>
   </div>
   <div class="field"><label data-i="feedMin">Low stock alert below</label><input name="min" type="number" inputmode="decimal" min="0" step="0.5" value="10"></div>
   <button class="primary" data-i="saveFeed">Add feed item</button>
  </form>
  <h2 style="margin-top:22px" data-i="feedListTitle">Current feed stock</h2>
  <div id="feedList" class="empty">No feed items added yet.</div>
 </section>

 <!-- MONEY -->
 <section id="money" class="panel hidden">
  <h2 data-i="moneyRecords">Income & expense record</h2>
  <form id="moneyForm">
   <div class="form-row">
    <div class="field"><label data-i="type">Record type</label>
     <select name="type">
      <option value="income" data-i="income">Income</option>
      <option value="expense" data-i="expense">Expense</option>
     </select>
    </div>
    <div class="field"><label data-i="amount">Amount (₹)</label><input name="amount" type="number" inputmode="decimal" min="1" step="0.01" required></div>
   </div>
   <div class="field"><label data-i="category">Description</label><input name="desc" required placeholder="e.g. Milk sale / cattle feed"></div>
   <div class="field"><label data-i="date">Date</label><input name="date" type="date" required></div>
   <button class="primary" data-i="saveRecord">Save record</button>
  </form>
  <h2 style="margin-top:22px" data-i="moneyHistory">Transaction history</h2>
  <div id="moneyList" class="empty">No transactions yet.</div>
 </section>

 <!-- HEALTH -->
 <section id="health" class="panel hidden">
  <h2 data-i="healthRecords">Cow health record</h2>
  <form id="healthForm">
   <div class="form-row">
    <div class="field"><label data-i="cow">Cow</label><select name="cow" id="healthCow" required><option value="">Select cow</option></select></div>
    <div class="field"><label data-i="healthDate">Date</label><input name="date" type="date" required></div>
   </div>
   <div class="field"><label data-i="healthNote">Medicine / vaccination / note</label><input name="note" required placeholder="e.g. Vaccination due"></div>
   <div class="field"><label data-i="nextDate">Next due date (optional)</label><input name="next" type="date"></div>
   <button class="primary" data-i="saveHealth">Save health record</button>
  </form>
  <h2 style="margin-top:22px" data-i="healthHistory">Health history</h2>
  <div id="healthList" class="empty">No health records yet.</div>
 </section>

 <!-- REPORTS & BACKUP -->
 <section id="reports" class="panel hidden">
  <h2 data-i="reportsTitle">Farm reports</h2>
  <div class="seg" id="reportSeg">
   <button class="active" data-period="daily" data-i="daily">Daily</button>
   <button data-period="weekly" data-i="weekly">Weekly</button>
   <button data-period="monthly" data-i="monthly">Monthly</button>
   <button data-period="all" data-i="allTime">All time</button>
  </div>
  <div id="reportRangeNote" class="period-note"></div>

  <div class="grid">
   <div class="stat"><small data-i="periodMilk">Milk recorded</small><strong id="repMilk">0 L</strong><span id="repMilkCount">0 entries</span></div>
   <div class="stat"><small data-i="estimatedValue">Estimated milk value</small><strong id="repMilkValue">₹0</strong><span id="repRateNote">₹50 / L</span></div>
   <div class="stat"><small data-i="totalIncome">Total income</small><strong id="repIncome">₹0</strong></div>
   <div class="stat"><small data-i="totalExpense">Total expenses</small><strong id="repExpense">₹0</strong></div>
  </div>

