function t(k){return words[lang][k]||k}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function money(n){
 const num=Number(n||0);
 const sign=num<0?'−':'';
 return sign+'₹'+Math.abs(num).toLocaleString('en-IN',{maximumFractionDigits:2});
}
function toast(msg){
 const el=$('#toast');
 el.textContent=msg;
 el.classList.add('show');
 clearTimeout(toastTimer);
 toastTimer=setTimeout(()=>el.classList.remove('show'),2400);
}
function dateSet(){
 document.querySelectorAll('input[type=date]').forEach(x=>{if(!x.value)x.value=today});
 if(!$('#billMonth').value)$('#billMonth').value=currentMonth;
}
function tab(id){
 document.querySelectorAll('main section[id]').forEach(s=>s.classList.toggle('hidden',s.id!==id));
 document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.tab===id));
}
function setCustSub(sub){
 custSub=sub;
 document.querySelectorAll('#custSubSeg button').forEach(b=>b.classList.toggle('active',b.dataset.sub===sub));
 $('#custSubSale').classList.toggle('hidden',sub!=='sale');
 $('#custSubAdd').classList.toggle('hidden',sub!=='add');
 $('#custSubBill').classList.toggle('hidden',sub!=='bill');
 if(sub==='bill')renderBill();
}

function milkKey(x){
 return `${(x.date||'').trim()}|${(x.cow||'').trim().toLowerCase()}|${(x.session||'').trim().toLowerCase()}`;
}
function getDuplicateKeys(milk){
 const counts={};
 milk.forEach(x=>{const k=milkKey(x);counts[k]=(counts[k]||0)+1;});
 return new Set(Object.keys(counts).filter(k=>counts[k]>1));
}
function translateSession(s){
 if(s==='Morning')return t('morning');
 if(s==='Evening')return t('evening');
 return s;
}

function getPeriodRange(period){
 const now=new Date();
 if(period==='daily')return {start:today,end:today,label:today};
 if(period==='weekly'){
  const d=new Date(now.getFullYear(),now.getMonth(),now.getDate()-6);
  const start=localDateStr(d);
  return {start,end:today,label:`${start} → ${today}`};
 }
 if(period==='monthly'){
  const start=`${today.slice(0,7)}-01`;
  const monthLabel=now.toLocaleDateString(lang==='hi'?'hi-IN':'en-IN',{month:'long',year:'numeric'});
  return {start,end:today,label:monthLabel};
 }
 return {start:null,end:null,label:t('allTime')};
}
function inRange(dateStr,range){
 if(!range.start)return true;
 return dateStr>=range.start && dateStr<=range.end;
}

function renderPnlCard(cardEl,statusEl,valEl,income,expense){
 const net=income-expense;
 cardEl.classList.remove('profit','loss');
 if(net>0){
  cardEl.classList.add('profit');
  const margin=income>0?` (${Math.round((net/income)*100)}%)`:'';
  statusEl.textContent=t('profit')+margin;
  valEl.textContent='+'+money(net);
 }else if(net<0){
  cardEl.classList.add('loss');
  statusEl.textContent=t('loss');
  valEl.textContent=money(net);
 }else{
  statusEl.textContent=t('breakeven');
  valEl.textContent='₹0';
 }
}

function resetMilkEdit(){
 editingMilkIndex=null;
 $('#milkForm').reset();
 $('#milkDate').value=today;
 $('#milkSubmitBtn').textContent=t('saveMilk');
 $('#cancelMilkEditBtn').classList.add('hidden');
 $('#milkEditBanner').classList.add('hidden');
}

function getCustomerBalance(custName,sales){
 const rows=sales.filter(s=>s.customer===custName);
 const billed=rows.reduce((a,s)=>a+(Number(s.qty||0)*Number(s.rate||0)),0);
 const paid=rows.reduce((a,s)=>a+Number(s.paid||0),0);
 return {billed,paid,due:billed-paid};
}

function buildBillData(){
 const custName=$('#billCust').value;
 const month=$('#billMonth').value||currentMonth;
 if(!custName)return null;
 const customers=read('customers');
 const sales=read('sales');
 const cust=customers.find(c=>c.name===custName)||{name:custName,phone:''};
 const rows=sales.filter(s=>s.customer===custName && (s.date||'').startsWith(month)).sort((a,b)=>a.date.localeCompare(b.date));
 const totalQty=rows.reduce((a,s)=>a+Number(s.qty||0),0);
 const totalAmt=rows.reduce((a,s)=>a+(Number(s.qty||0)*Number(s.rate||0)),0);
 const totalPaid=rows.reduce((a,s)=>a+Number(s.paid||0),0);
 return {cust,month,rows,totalQty,totalAmt,totalPaid,due:totalAmt-totalPaid};
}

function renderBill(){
 const data=buildBillData();
 const el=$('#billPreview');
 if(!data){
  el.className='bill-box empty';
  el.textContent=lang==='hi'?'मासिक बिल देखने के लिए ग्राहक चुनें।':'Select a customer to preview monthly bill.';
  return;
 }
 el.className='bill-box';
 const rowsHtml=data.rows.length?data.rows.map(r=>{
  const amt=Number(r.qty||0)*Number(r.rate||0);
  return `<tr><td>${esc(r.date)}</td><td>${esc(translateSession(r.session))}</td><td>${Number(r.qty||0).toFixed(1)} L</td><td>${money(amt)}</td></tr>`;
 }).join(''):`<tr><td colspan="4" class="muted">${lang==='hi'?'इस महीने कोई बिक्री दर्ज नहीं है।':'No sales recorded for this month.'}</td></tr>`;

 el.innerHTML=`
